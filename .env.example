# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Local dev database (docker compose publishes Postgres on 5433).
DATABASE_URL=postgresql+psycopg://accrue:accrue@localhost:5433/accrueboard

# Model per pipeline step (defaults shown).
# MODEL_CLASSIFY=claude-haiku-4-5
# MODEL_EXTRACT=claude-sonnet-5
# MODEL_VERIFY=claude-sonnet-5
# MODEL_CODE=claude-sonnet-5
# Record/replay mode for model calls: live | record | replay | auto
LLM_MODE=auto
